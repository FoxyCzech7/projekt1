{block content}

<div class="admin-toolbar">
    <h1>Správa uživatelů</h1>
    <a n:href="Admin:importFeed"
       class="btn-import-feed"
       onclick="return confirm('Stáhnout a importovat nejnovější článek z feedu ancient-literature.com?')">
        ↓ Importovat z RSS feedu
    </a>
</div>

<table class="admin-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Uživatelské jméno</th>
            <th>E-mail</th>
            <th>Role</th>
            <th>Premium</th>
            <th>Poslední přihlášení</th>
            <th>Akce</th>
        </tr>
    </thead>
    <tbody>
        {foreach $users as $u}
        <tr>
            <td>{$u->id}</td>
            <td>{$u->username|escape}</td>
            <td>{$u->email|escape}</td>
            <td><span class="role-badge role-{$u->role|escape}">{$u->role|escape}</span></td>
            <td>
                {var $premiumUntil = isset($u->premium_until) ? $u->premium_until : null}
                {if $premiumUntil instanceof \DateTimeInterface && $premiumUntil > new \DateTimeImmutable()}
                    <span class="premium-status active" title="Aktivní do {$premiumUntil|date:'j. n. Y'}">
                        ★ do {$premiumUntil|date:'j. n. Y'}
                    </span>
                {else}
                    <span class="muted">—</span>
                {/if}
            </td>
            <td>
                {if isset($u->last_login) && $u->last_login}
                    {$u->last_login|date:'j. n. Y H:i'}
                {else}
                    <span class="muted">—</span>
                {/if}
            </td>
            <td>
                <a n:href="Admin:profile $u->id" class="btn-profile">Zobrazit profil</a>
            </td>
        </tr>
        {/foreach}
    </tbody>
</table>

{/block}
