{block content}

<p><a class="back-link" n:href="Admin:default">← Zpět na seznam uživatelů</a></p>

<h1>Profil: {$profile->username|escape}</h1>

<div class="profile-grid">

    <section class="profile-card">
        <h2>Základní informace</h2>
        <table class="info-table">
            <tr>
                <th>Uživatelské jméno</th>
                <td>{$profile->username|escape}</td>
            </tr>
            <tr>
                <th>Jméno</th>
                <td>{if $profile->first_name}{$profile->first_name|escape}{else}<span class="muted">—</span>{/if}</td>
            </tr>
            <tr>
                <th>Příjmení</th>
                <td>{if $profile->last_name}{$profile->last_name|escape}{else}<span class="muted">—</span>{/if}</td>
            </tr>
            <tr>
                <th>E-mail</th>
                <td>
                    {if $profile->email}
                        <a href="mailto:{$profile->email|escape}">{$profile->email|escape}</a>
                    {else}
                        <span class="muted">—</span>
                    {/if}
                </td>
            </tr>
            <tr>
                <th>Role</th>
                <td><span class="role-badge role-{$profile->role|escape}">{$profile->role|escape}</span></td>
            </tr>
            <tr>
                <th>Poslední přihlášení</th>
                <td>
                    {if $profile->last_login}
                        {$profile->last_login|date:'j. n. Y H:i'}
                    {else}
                        <span class="muted">Nezaznamenáno</span>
                    {/if}
                </td>
            </tr>
        </table>
    </section>

    <section class="profile-card">
        <h2>Statistiky</h2>
        <div class="stats-grid">
            <div class="stat-box">
                <span class="stat-value">{$profile->post_count}</span>
                <span class="stat-label">Příspěvků</span>
            </div>
            <div class="stat-box">
                <span class="stat-value">{$profile->comment_count}</span>
                <span class="stat-label">Komentářů</span>
            </div>
            <div class="stat-box">
                <span class="stat-value">{$profile->comment_likes}</span>
                <span class="stat-label">Lajků na komentářích</span>
            </div>
        </div>
    </section>

</div>

<section class="profile-card chart-card">
    <h2>Aktivita za posledních 12 měsíců</h2>
    <canvas id="activityChart" height="80"></canvas>
</section>

{block scripts}
    {include parent}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script>
        new Chart(document.getElementById('activityChart'), {
            type: 'line',
            data: {
                labels: {$chartLabels|noescape},
                datasets: [
                    {
                        label: 'Příspěvky',
                        data: {$chartPosts|noescape},
                        borderColor: '#1abc9c',
                        backgroundColor: 'rgba(26,188,156,0.1)',
                        tension: 0.4,
                        fill: true,
                        pointRadius: 4,
                    },
                    {
                        label: 'Komentáře',
                        data: {$chartComments|noescape},
                        borderColor: '#2980b9',
                        backgroundColor: 'rgba(41,128,185,0.1)',
                        tension: 0.4,
                        fill: true,
                        pointRadius: 4,
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'top' },
                    tooltip: { mode: 'index', intersect: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, precision: 0 }
                    }
                }
            }
        });
    </script>
{/block}

{/block}
