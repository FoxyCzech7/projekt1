{block content}

<p><a class="back-link" n:href="Home:default">← Zpět na úvodní stránku</a></p>

{if $user->isInRole('admin') || $post->user_id === $user->getId()}
    <p>
        <a n:href="Edit:edit id => $post->id, type => 'post'" class="back-link">Upravit příspěvek</a>
    </p>
{/if}

<div>
    <div style="position: relative; margin-bottom: 1em;">
        <div class="date">{$post->created_at|date:'j. n. Y'}</div>
        <h1 n:block="title">{$post->title|escape}</h1>
    </div>

    <div class="post">
        {if $post->image}
            <div class="post-image">
                 <img src="{$basePath}/{$post->image}" alt="Obrázek k příspěvku" style="max-width: 200px; width: 100%; height: 200px; margin-left: 15px; margin-top: 15px; object-fit: cover;">
            </div>
        {/if}

        {$post->content|noescape}
        <div>
            <a 
                n:href="like! $post->id"
                class="like-btn {if $userHasLiked[$post->id] ?? false}liked{/if}">
                {if $userHasLiked[$post->id] ?? false}❤️{else}🤍{/if}
                {$post->likes_count}
            </a>
        </div>
    </div>
</div>

<h2>Vložte nový komentář</h2>

{if $user->isInRole('user') || $user->isInRole('author') || $user->isInRole('admin')}
    {form commentForm}
        <div class="form-group">
            {label content /}
            {input content}
        </div>
        {input send}
    {/form}
{else}
    <p class="comment-login-prompt">
        Pro psaní komentářů se prosím <a n:href="Sign:in">přihlaste</a> nebo <a n:href="Sign:register">zaregistrujte</a>.
    </p>
{/if}

<h2>Komentáře ({count($comments)})</h2>

<div class="comments">
    {if count($comments) > 0}
        {foreach $comments as $comment}
            <div class="comment">
                <p>
                    <b>
                        {if $comment->email}
                            <a href="mailto:{$comment->email|escape}">{$comment->username|escape}</a>
                        {else}
                            {$comment->username|escape}
                        {/if}
                    </b> napsal dne {$comment->created_at|date:'j. n. Y H:i'}:
                </p>
                <div>{$comment->content|noescape}</div>

                <div>
                    <a n:href="likeComment! $comment->id"
                       class="like-btn {if $userHasLikedComments[$comment->id] ?? false}liked{/if}">
                        {if $userHasLikedComments[$comment->id] ?? false}❤️{else}🤍{/if}
                        {$comment->likes_count ?? 0}
                    </a>
                </div>

                {if $user->isInRole('admin') 
                    || (($user->isInRole('author') || $user->isInRole('user')) && $comment->user_id === $user->getId())}
                    <p>
                        <a n:href="Post:deleteComment id => $comment->id"
                           onclick="return confirm('Opravdu chcete smazat tento komentář?')" class="delete-post">
                            Smazat komentář
                        </a>
                        |
                        <a n:href="Edit:edit id => $comment->id, type => 'comment'" class="edit-comment">Upravit komentář</a>
                    </p>
                {/if}
            </div>
        {/foreach}
    {else}
        <p>Žádné komentáře zatím nebyly přidány.</p>
    {/if}   
</div>

{/block}
