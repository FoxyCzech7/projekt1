<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{ifset title}{include title|stripHtml} | {/ifset}Vojenská Technika</title>
	<link rel="stylesheet" href="{$basePath}/css/style.css">
</head>

<body>

	<div class="site-header">
		<div class="site-header-icon">⚔️</div>
		<div class="site-header-text">
			<div class="site-title">Vojenská Technika</div>
			<div class="site-subtitle">Zpravodajství · Analýzy · Bojové systémy</div>
		</div>
	</div>

	<ul class="navig">
		<li><a n:href="Home:">Články</a></li>

		{if $user->isLoggedIn()}
			{if $user->isInRole('admin')}
				<li><a n:href="Admin:default">⚙ Admin</a></li>
			{/if}
			<li><a n:href="Premium:plans" class="nav-premium">★ Premium</a></li>
			<li><a n:href="PostForm:create">+ Nový článek</a></li>
			<li><a n:href="Sign:out">Odhlásit</a></li>
		{else}
			<li><a n:href="Premium:plans" class="nav-premium">★ Premium</a></li>
			<li><a n:href="Sign:in">Přihlásit</a></li>
			<li><a n:href="Sign:register">Registrovat</a></li>
		{/if}
	</ul>

	<div n:foreach="$flashes as $flash" n:class="flash, $flash->type">{$flash->message}</div>

	{block content}{/block}

	{block scripts}
		<script src="https://unpkg.com/nette-forms@3"></script>
	{/block}

</body>
</html>
