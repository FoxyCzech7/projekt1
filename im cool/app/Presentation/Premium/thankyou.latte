{block content}

<div class="thankyou-wrap">
    <div class="thankyou-card">
        <div class="thankyou-icon">✓</div>
        <h1>Platba proběhla úspěšně!</h1>
        <p>Děkujeme za zakoupení prémiového předplatného.</p>

        <table class="thankyou-table">
            <tr>
                <th>Předplatné</th>
                <td>Premium — {$plan['name']}</td>
            </tr>
            <tr>
                <th>Délka</th>
                <td>{$plan['months']} {if $plan['months'] === 1}měsíc{elseif $plan['months'] < 5}měsíce{else}měsíců{/if}</td>
            </tr>
            <tr>
                <th>Zaplaceno</th>
                <td>{$plan['price']} Kč</td>
            </tr>
            <tr>
                <th>Premium aktivní do</th>
                <td><strong>{$expiry|date:'j. n. Y'}</strong></td>
            </tr>
        </table>

        <a n:href="Home:default" class="button" style="margin-top: 24px; display: inline-block;">
            Přejít na články →
        </a>
    </div>
</div>

{/block}
