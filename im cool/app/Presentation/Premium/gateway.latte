{block content}

<div class="gateway-wrap">
    <div class="gateway-card">
        <div class="gateway-spinner"></div>
        <h2>Zpracovávám platbu&hellip;</h2>
        <p>Prosím čekejte, platba se zpracovává.</p>
        <p class="gateway-amount">{$cart['price']} Kč — {$cart['name']}</p>
    </div>
</div>

{block scripts}
    {include parent}
    <script>
        // Simulace platební brány — přesměrování po 2 sekundách.
        setTimeout(() => {
            window.location.href = {$thankyouUrl|json|noescape};
        }, 2000);
    </script>
{/block}

{/block}
