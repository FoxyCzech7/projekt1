{block content}

<h1>Notifikace</h1>

{if count($notifications) === 0}
    <p class="muted" style="text-align:center; padding: 40px">Žádné notifikace.</p>
{else}
    <div style="max-width: 680px; margin: 0 auto">
        {foreach $notifications as $n}
            <div class="notif-card {if !$n->read_at}notif-unread{/if}">
                <div class="notif-icon">
                    {if $n->type === 'post_like'}❤️
                    {elseif $n->type === 'comment_like'}💬
                    {elseif $n->type === 'comment_reply'}↩
                    {else}🔔{/if}
                </div>
                <div class="notif-body">
                    <div class="notif-message">
                        {if $n->link}
                            <a href="{$n->link|escape}">{$n->message|escape}</a>
                        {else}
                            {$n->message|escape}
                        {/if}
                    </div>
                    <div class="notif-date">{$n->created_at|date:'j. n. Y H:i'}</div>
                </div>
            </div>
        {/foreach}
    </div>
{/if}

{/block}
