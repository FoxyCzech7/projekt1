{block content}

<h1>Premium předplatné</h1>

{if $premiumUntil}
    <div class="premium-active-banner">
        ✓ Máte aktivní Premium do <strong>{$premiumUntil|date:'j. n. Y'}</strong>.
        Zakoupením nového plánu prodloužíte předplatné od tohoto data.
    </div>
{/if}

<p class="premium-subtitle">Získejte neomezený přístup ke všem prémiovým článkům.</p>

<div class="plans-grid">
    {foreach $plans as $plan}
        <div class="plan-card {if $currentCart && $currentCart['id'] === $plan['id']}plan-selected{/if}">
            <div class="plan-name">{$plan['name']}</div>
            <div class="plan-price">{$plan['price']} Kč</div>
            <div class="plan-per">
                {if $plan['months'] === 1}
                    {$plan['price']} Kč / měsíc
                {else}
                    {round($plan['price'] / $plan['months'])} Kč / měsíc
                {/if}
            </div>
            <a n:href="Premium:addToCart $plan['id']" class="plan-btn">
                {if $currentCart && $currentCart['id'] === $plan['id']}
                    ✓ V košíku
                {else}
                    Vybrat
                {/if}
            </a>
        </div>
    {/foreach}
</div>

{if $currentCart}
    <div class="cart-hint">
        Máte v košíku: <strong>{$currentCart['name']}</strong> za <strong>{$currentCart['price']} Kč</strong>.
        <a n:href="Premium:cart" class="btn-goto-cart">Přejít do košíku →</a>
    </div>
{/if}

{/block}
