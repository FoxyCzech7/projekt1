premium{block content}

<h1>Vojenský Blog</h1>

<div>
    {foreach $posts as $post}
        <div class="post">
            <div class="date">{$post->created_at|date:'F j, Y'}</div>

            {if $post->is_premium}
                <span class="premium-badge">★ Premium</span>
            {/if}

            {if $post->image}
                <div style="display: flex; align-items: flex-start; gap: 16px;">
                    <img src="{$basePath}/{$post->image}" alt="Obrázek k příspěvku"
                         style="flex-shrink: 0; width: 120px; height: 120px; object-fit: cover; border-radius: 4px;">
                    <h2 style="margin: 0; min-width: 0;">
                        <a n:href="Post:show $post->id">{$post->title}</a>
                    </h2>
                </div>
            {else}
                <h2><a n:href="Post:show $post->id">{$post->title}</a></h2>
            {/if}

            {if $post->is_premium && !$hasFullAccess}
                <div class="premium-teaser">
                    {$post->content|truncate:150}
                    <span class="premium-teaser-cta">
                        … <a n:href="Premium:plans">Odemknout Premium →</a>
                    </span>
                </div>
            {else}
                <div>{$post->content|truncate:256}</div>
            {/if}

            <div class="post-actions">
                <a n:href="like! $post->id"
                   class="like-btn {if isset($userHasLiked[$post->id]) && $userHasLiked[$post->id]}liked{/if}">
                    {if isset($userHasLiked[$post->id]) && $userHasLiked[$post->id]}❤️{else}🤍{/if}
                    {$post->likes_count}
                </a>

                <a n:href="Post:show $post->id" class="like-btn">Číst</a>

                {if $user->isInRole('admin') || ($user->isInRole('author') && $post->user_id === $user->id)}
                    <a n:href="PostForm:edit $post->id" class="like-btn">Upravit</a>
                    <a n:href="Home:delete $post->id" class="like-btn like-btn--delete"
                       onclick="return confirm('Opravdu chcete smazat tento příspěvek?')">Smazat</a>
                {/if}
            </div>
        </div>
    {/foreach}
</div>

{if $paginator->pageCount > 1}
  <div class="pagination">
    {if !$paginator->isFirst()}
      <a class="button" n:href="this page => $paginator->page - 1">← Předchozí</a>
    {/if}

    {for $i = 1; $i <= $paginator->pageCount; $i++}
      {if $i === $paginator->page}
        <strong class="current-page">{$i}</strong>
      {else}
        <a class="button" n:href="this page => $i">{$i}</a>
      {/if}
    {/for}

    {if !$paginator->isLast()}
      <a class="button" n:href="this page => $paginator->page + 1">Další →</a>
    {/if}
  </div>
{/if}

{/block}
