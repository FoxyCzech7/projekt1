{*
  Rekurzivní blok pro vykreslení jednoho komentáře a všech jeho potomků.
  Volá sám sebe přes {include #comment} pro každé child.
  $depth řídí vizuální odsazení (max 5 úrovní, pak se dál neodsazuje).
*}
{define comment}
<div class="comment {if $depth > 0}comment-child{/if}" style="margin-left: {min($depth * 28, 140)}px">
    <div class="comment-meta">
        <b>
            {if $comment->user_id}
                <a n:href="Profile:view $comment->user_id" class="comment-author-link">{$comment->username|escape}</a>
            {else}
                {$comment->username|escape}
            {/if}
        </b>
        <span class="comment-date">{$comment->created_at|date:'j. n. Y H:i'}</span>
    </div>

    <div class="comment-body">{$comment->content|escape}</div>

    <div class="comment-actions">
        <a n:href="likeComment! $comment->id"
           class="like-btn {if $userHasLikedComments[$comment->id] ?? false}liked{/if}">
            {if $userHasLikedComments[$comment->id] ?? false}❤️{else}🤍{/if}
            {$comment->likes_count ?? 0}
        </a>

        <button class="like-btn like-btn--reply"
                data-reply-id="{$comment->id}"
                data-reply-author="{$comment->username|escape}">
            ↩ Odpovědět
        </button>

        {if $user->isInRole('admin')
            || (($user->isInRole('author') || $user->isInRole('user')) && $comment->user_id === $user->getId())}
            <a n:href="Edit:edit id => $comment->id, type => 'comment'"
               class="like-btn">Upravit</a>
            <a n:href="Comment:delete $comment->id"
               onclick="return confirm('Opravdu chcete smazat tento komentář?')"
               class="like-btn like-btn--delete">Smazat</a>
        {/if}
    </div>

    {if $comment->children}
        {foreach $comment->children as $child}
            {include #comment, comment: $child, depth: $depth + 1}
        {/foreach}
    {/if}
</div>
{/define}


{block content}

<div class="post-nav">
    <a class="back-link" n:href="Home:default">← Zpět</a>
    {if $user->isInRole('admin') || $post->user_id === $user->getId()}
        <a n:href="PostForm:edit $post->id" class="back-link">Upravit příspěvek</a>
    {/if}
    <span class="date">{$post->created_at|date:'j. n. Y'}</span>
</div>

<div>
    <div>
        <h1 n:block="title">{$post->title|escape}</h1>
    </div>

    <div class="post">
        {if $postAuthor}
            <div class="post-author-meta">
                Autor: <a n:href="Profile:view $postAuthor->id" class="post-author-link">@{$postAuthor->username|escape}</a>
            </div>
        {/if}

        {if $tags}
            <div class="tags-list">
                {foreach $tags as $tag}
                    <a n:href="Home:default tag => $tag->slug" class="tag">{$tag->name|escape}</a>
                {/foreach}
            </div>
        {/if}

        {if $post->image}
            <div class="post-image">
                <img src="{$basePath}/{$post->image}" alt="Obrázek k příspěvku"
                     style="max-width: 200px; width: 100%; height: 200px; margin-left: 15px; margin-top: 15px; object-fit: cover;">
            </div>
        {/if}

        {if $post->is_premium && !$hasFullAccess}
            <div class="premium-preview">
                {$post->content|truncate:300|noescape}
            </div>
            <div class="premium-overlay">
                <div class="premium-overlay-inner">
                    <div class="premium-lock">🔒</div>
                    <h3>Prémiový obsah</h3>
                    <p>Zbytek článku je dostupný pouze pro prémiové uživatele.</p>
                    <a n:href="Premium:plans" class="btn-buy-premium">Získat Premium</a>
                </div>
            </div>
        {else}
            {$post->content|noescape}
        {/if}

        <div>
            <a n:href="like! $post->id"
               class="like-btn {if $userHasLiked[$post->id] ?? false}liked{/if}">
                {if $userHasLiked[$post->id] ?? false}❤️{else}🤍{/if}
                {$post->likes_count}
            </a>
        </div>
    </div>
</div>

<h2>Komentáře ({count($comments)})</h2>

<div class="comments" id="comments-section">
    {if count($comments) > 0}
        {foreach $comments as $rootComment}
            {include #comment, comment: $rootComment, depth: 0}
        {/foreach}
    {else}
        <p>Žádné komentáře zatím nebyly přidány.</p>
    {/if}
</div>

{* ───── Formulář pro nový komentář / odpověď ───── *}
<div id="comment-form-section">
    <h2 id="comment-form-title">Vložte nový komentář</h2>

    {* Banner zobrazí se po kliknutí na "Odpovědět" — JS ho ovládá *}
    <div id="reply-banner" style="display:none" class="reply-banner">
        <span>↩ Reagujete na komentář uživatele: <strong id="reply-author"></strong></span>
        <button id="cancel-reply" type="button" class="cancel-reply">× Zrušit</button>
    </div>

    {if $user->isInRole('user') || $user->isInRole('author') || $user->isInRole('admin')}
        {form commentForm}
            {* parent_id nastavuje JS; při přímém odeslání formuláře je 0 (kořenový) *}
            {input parent_id}
            <div class="form-group">
                {label content /}
                {input content}
            </div>
            {input send}
        {/form}
    {else}
        <p class="comment-login-prompt">
            Pro psaní komentářů se prosím
            <a n:href="Sign:in">přihlaste</a> nebo <a n:href="Sign:register">zaregistrujte</a>.
        </p>
    {/if}
</div>

{block scripts}
    {include parent}
    <script>
        const parentInput = document.querySelector('[name="parent_id"]');
        const replyBanner = document.getElementById('reply-banner');
        const replyAuthor = document.getElementById('reply-author');
        const formTitle   = document.getElementById('comment-form-title');
        const formSection = document.getElementById('comment-form-section');

        document.querySelectorAll('[data-reply-id]').forEach(btn => {
            btn.addEventListener('click', () => {
                const id     = btn.dataset.replyId;
                const author = btn.dataset.replyAuthor;

                parentInput.value   = id;
                replyAuthor.textContent = author;
                replyBanner.style.display = 'flex';
                formTitle.textContent = 'Odpovědět na komentář';

                formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });

        document.getElementById('cancel-reply')?.addEventListener('click', () => {
            parentInput.value = '0';
            replyBanner.style.display = 'none';
            formTitle.textContent = 'Vložte nový komentář';
        });
    </script>
{/block}

{/block}
