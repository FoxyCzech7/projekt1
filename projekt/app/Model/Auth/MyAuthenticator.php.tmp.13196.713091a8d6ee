<?php

namespace App\Model\Auth;

use Nette;
use Nette\Security\Authenticator;
use Nette\Security\IIdentity;
use Nette\Security\Identity;
use Nette\Security\AuthenticationException;

// Autentizátor pro Nette Security — implementuje rozhraní Authenticator.
// Ověřuje přihlašovací jméno a heslo uživatele a vrací jeho Identity.
final class MyAuthenticator implements Authenticator
{
    use Nette\SmartObject;

    public function __construct(
        private Nette\Database\Explorer $database,
        private Nette\Security\Passwords $passwords,
    ) {}

    // Ověří přihlašovací údaje a vrátí Identity s ID, rolí a uživatelským jménem.
    // Hází AuthenticationException s popisem konkrétní příčiny chyby.
    public function authenticate(string|array $credentials, string $password): IIdentity
    {
        // Podporujeme předání credentials jako pole (s klíčem 'username') nebo přímo jako string.
        $username = is_array($credentials) ? ($credentials['username'] ?? null) : $credentials;
        if (!$username) {
            throw new AuthenticationException('Uživatelské jméno nebylo zadáno.');
        }

        $user = $this->database->table('users')
            ->where('username', $username)
            ->fetch();

        if (!$user) {
            throw new AuthenticationException('Uživatel nenalezen.');
        }

        // passwords->verify() bezpečně porovná plaintext s uloženým hashem.
        if (!$this->passwords->verify($password, $user->password)) {
            throw new AuthenticationException('Nesprávné heslo.');
        }

        // Identity obsahuje ID, roli (pro RBAC) a data přístupná přes $identity->username.
        return new Identity($user->id, $user->role, ['username' => $user->username]);
    }

    // Tyto metody umožní SignPresenteru přistoupit k databázi a hashování pro registraci.
    public function getDatabase(): Nette\Database\Explorer
    {
        return $this->database;
    }

    // Zpřístupní instanci Passwords pro hashování hesel při registraci.
    public function getPasswords(): Nette\Security\Passwords
    {
        return $this->passwords;
    }
}
